map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;
    # Keep redirects relative so a published port or an outer TLS gateway survives.
    absolute_redirect off;
    client_max_body_size 100m;

    location = ${RELAY_BASE_PATH} {
        return 308 ${RELAY_BASE_PATH}/$is_args$args;
    }

    location ${RELAY_BASE_PATH}/ {
        # A trailing slash on proxy_pass strips the matched public base path.
        proxy_pass http://relay:3005/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
