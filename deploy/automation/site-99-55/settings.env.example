# Non-secret interpolation only. Blank mandatory values intentionally prevent startup.
# These image refs must include a reviewed immutable sha256 digest, not just a mutable tag.
CONTROL_NODE_IMAGE=
CONTROL_IMAGE=
CONTROL_NGINX_IMAGE=
# Proposed NEW directories on 99.55; not created or provisioned by these examples.
CONTROL_CONFIG_DIRECTORY=/data/code/happy-control/config
CONTROL_STATE_DIRECTORY=/data/code/happy-control/state
# Runtime tmpfs projection from an approved secret provider, not a persistent key directory.
CONTROL_PKI_DIRECTORY=/run/happy-control/pki
