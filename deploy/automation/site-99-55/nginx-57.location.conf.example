# Add only inside the EXISTING 7100 ssl server after review/backup.
# Keep /happy/ and /home-relay/ exactly as they are. No prefix rewrite or URI in proxy_pass.
location ^~ /happy-control/v1/ {
    proxy_pass https://192.168.99.55:9011;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Connection "";
    proxy_set_header Authorization $http_authorization;
    proxy_ssl_server_name on;
    proxy_ssl_name happy-control-55.internal;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_trusted_certificate /etc/nginx/happy-control-pki/server-ca.crt;
    proxy_ssl_certificate /etc/nginx/happy-control-pki/client.crt;
    proxy_ssl_certificate_key /etc/nginx/happy-control-pki/client.key;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_connect_timeout 3s;
    proxy_send_timeout 60s;
    proxy_read_timeout 90s;
    client_max_body_size 32m;
    access_log off;
    error_log stderr crit;
}
location = /happy-control/mcp {
    proxy_pass https://192.168.99.55:9011;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Connection "";
    proxy_set_header Authorization $http_authorization;
    proxy_ssl_server_name on;
    proxy_ssl_name happy-control-55.internal;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_trusted_certificate /etc/nginx/happy-control-pki/server-ca.crt;
    proxy_ssl_certificate /etc/nginx/happy-control-pki/client.crt;
    proxy_ssl_certificate_key /etc/nginx/happy-control-pki/client.key;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_connect_timeout 3s;
    proxy_send_timeout 60s;
    proxy_read_timeout 90s;
    client_max_body_size 32m;
    access_log off;
    error_log stderr crit;
}
