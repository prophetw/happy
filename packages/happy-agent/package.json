{
  "name": "happy-agent",
  "version": "0.1.0",
  "description": "CLI client for controlling Happy Coder agents remotely",
  "author": "Kirill Dubovitskiy",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/slopus/happy/tree/main/packages/happy-agent",
  "bugs": "https://github.com/slopus/happy/issues",
  "repository": "slopus/happy",
  "bin": {
    "happy-agent": "./bin/happy-agent.mjs",
    "happy-control": "./bin/happy-control.mjs",
    "happy-control-call": "./bin/happy-control-call.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./automation": {
      "import": {
        "types": "./dist/automation/rest/index.d.mts",
        "default": "./dist/automation/rest/index.mjs"
      },
      "require": {
        "types": "./dist/automation/rest/index.d.cts",
        "default": "./dist/automation/rest/index.cjs"
      }
    },
    "./automation/production": {
      "import": {
        "types": "./dist/automation/production/index.d.mts",
        "default": "./dist/automation/production/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --noEmit && pkgroll",
    "test": "$npm_execpath run build && vitest run",
    "test:integration": "$npm_execpath run build && vitest run --config vitest.integration.config.ts",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "$npm_execpath run build && $npm_execpath test",
    "release": "npx --no-install release-it"
  },
  "dependencies": {
    "@slopus/happy-wire": "workspace:*",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io-client": "^4.8.1",
    "tweetnacl": "^1.0.3",
    "fastify": "^5.6.2",
    "zod": "^4.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "jose": "6.2.2"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "@types/qrcode-terminal": "^0.12.2",
    "pkgroll": "^2.14.2",
    "release-it": "^19.0.6",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@10.11.0"
}
