# Address clients will use. Must match the configured gateway path below.
# Use your server's domain/IP instead of YOUR_SERVER. No trailing slash.
RELAY_PUBLIC_URL=http://YOUR_SERVER:8193/relay

# Public HTTP listener. Use 127.0.0.1 when another local gateway terminates HTTPS.
RELAY_BIND_ADDRESS=0.0.0.0
RELAY_PORT=8193

# Non-empty path prefix, beginning with / and without a trailing slash.
# For example /relay or /team/relay. Keep this consistent with RELAY_PUBLIC_URL.
RELAY_BASE_PATH=/relay

# Generate once with: openssl rand -hex 32
# Keep this value and the relay-data volume across container restarts/upgrades.
HANDY_MASTER_SECRET=

# Only these existing Happy account IDs can use the relay (comma-separated).
# Empty denies everyone. * explicitly enables public access; use only for private bootstrap.
HAPPY_ALLOWED_ACCOUNT_IDS=

# Optional image tag when building locally on the server.
RELAY_IMAGE=happy-relay:local
